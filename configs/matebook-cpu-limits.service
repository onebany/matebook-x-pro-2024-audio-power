[Unit]
Description=MateBook X Pro: CPU limits (fan does not ramp on Linux, uncapped cores hit 100 C)
After=systemd-modules-load.service

[Service]
Type=oneshot
# ponytail: static values measured 2026-10-09; re-tune if fan behaviour or background load changes.
ExecStartPre=/usr/sbin/modprobe intel_rapl_msr
ExecStart=/bin/sh -c 'for f in /sys/devices/system/cpu/cpufreq/policy*/scaling_max_freq; do echo 3200000 > "$f"; done; z=/sys/class/powercap/intel-rapl:0; echo 30000000 > $z/constraint_1_power_limit_uw; echo 27983872 > $z/constraint_0_time_window_us; echo 18000000 > $z/constraint_0_power_limit_uw'

[Install]
WantedBy=multi-user.target
